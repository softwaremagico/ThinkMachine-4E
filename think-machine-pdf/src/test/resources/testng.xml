<suite thread-count="1" verbose="1" name="ThinkingMachinePdf" parallel="false">
    <listeners>
        <listener class-name="com.softwaremagico.tm.TestListener"/>
    </listeners>
    <!-- Every test class is executed. Do not filter by <groups> or <classes>:
         new tests must run automatically on 'mvn install'.
         Only the 'manual' group is excluded (long exploratory tools). -->
    <test name="AllPdfTests" enabled="true" preserve-order="true">
        <groups>
            <run>
                <exclude name="manual"/>
            </run>
        </groups>
        <packages>
            <package name="com.softwaremagico.tm.*"/>
        </packages>
    </test>
</suite>
